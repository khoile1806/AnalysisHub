# ─── App ───────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=3000

# ─── Database ──────────────────────────────────────────────
POSTGRES_DB=analysishub
POSTGRES_USER=forensic
POSTGRES_PASSWORD=forensic_secret

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars

# ─── Admin seed account ────────────────────────────────────
ADMIN_EMAIL=admin@analysishub.local
ADMIN_PASSWORD=Admin@123456

# Base URL used for agent install scripts and job dispatch.
# Automatically detected from request headers if unset.
# Examples: "http://192.168.1.10:8080" or "https://hub.example.com"
PUBLIC_URL=

# Public base URL for OSINT canary-token links (/c/<slug>). Decoupled from
# PUBLIC_URL so you can front canary links with a SEPARATE / disposable domain
# (or reverse proxy / Cloudflare Tunnel) and never expose the real AnalysisHub
# host to whoever clicks the link. If unset, a per-token override or the request
# host is used. Example: "https://promo-event.io"
# When using Cloudflare Tunnel (below), set this to your tunnel's public hostname.
CANARY_BASE_URL=

# Cloudflare Tunnel token — fronts canary links so the real server IP is hidden.
# Get it from Cloudflare Zero Trust → Networks → Tunnels → (create) → token.
# Then start the optional service:  docker compose --profile tunnel up -d
# Map the tunnel's Public Hostname (Service = HTTP → backend:8080, Path = /c/*)
# to the same domain you put in CANARY_BASE_URL above.
CLOUDFLARE_TUNNEL_TOKEN=

# Outbound alert notifications — fired (best-effort) when a human opens a canary
# token (link / image / document). All optional; leave blank to disable a channel.
#   NOTIFY_WEBHOOK_URL    — receives a JSON POST {title,text,content} (Slack/Discord/
#                           generic webhooks all accept this shape).
#   NOTIFY_TELEGRAM_*     — send via a Telegram bot: create one with @BotFather for
#                           the token, and use @userinfobot (or the chat) for the id.
NOTIFY_WEBHOOK_URL=
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Force the automatically-detected URL to use HTTPS.
# Set to 'true' if running behind an SSL-terminating proxy that does
# not send standard X-Forwarded-Proto headers.
USE_HTTPS=false

# Extra browser origins allowed for CORS and WebSocket upgrades (comma-separated).
#
# You normally do NOT need to touch this. The frontend is served by the same
# nginx that proxies /api and /ws, so the browser is always same-origin, and
# same-origin requests are accepted whatever address the server was reached by —
# http://localhost:3000, http://192.168.1.10:3000 and https://hub.example.com all
# work with this left as-is.
#
# Set it only when a DIFFERENT origin must talk to this backend: a separately
# hosted frontend, or a second domain pointing at the same API.
# Example: https://admin.example.com,https://ops.example.com
ALLOWED_ORIGINS=

# ─── CVE Intel (optional, raises rate limits) ─────────────
# NVD: 5 req/30s without key → 50 with key. Free signup: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub Search: 10 req/min without token → 30 with token. Personal access token (no scopes needed).
GITHUB_TOKEN=

# ─── Threat Intelligence / OSINT API keys ─────────────────
# Used by AI IOC enrichment AND the OSINT module's reputation collectors. EVERY
# key below is OPTIONAL — a missing key only skips that one source. Many sources
# need NO key and always run: crt.sh, certspotter, Shodan InternetDB, RDAP,
# ip-api, ProxyNova, XposedOrNot, CIRCL hashlookup, ransomware.live, urlscan,
# HackerTarget, Wayback, blockchain explorers, GreyNoise community, Wappalyzer.
#
# --- FREE keys (recommended) ----------------------------------------------
# VirusTotal: up to 4 free keys, rotated round-robin (4 req/min each).
#   Get: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_1=
VIRUSTOTAL_2=
VIRUSTOTAL_3=
VIRUSTOTAL_4=
# Shodan host API (InternetDB works keyless regardless). Get: https://account.shodan.io
SHODAN=
# AbuseIPDB IP reputation. Get (free): https://www.abuseipdb.com/account/api
ABUSEIPDB=
# AlienVault OTX. Get (free): https://otx.alienvault.com → Settings → API Integration
ALIENVAULT=
# abuse.ch Auth-Key — ONE key unlocks threatfox + urlhaus + malwarebazaar.
#   Get (free): https://auth.abuse.ch  (these APIs require a key since 2024)
ABUSE_CH_API_KEY=
# Pulsedive risk score. Get (free tier): https://pulsedive.com/account
PULSEDIVE_API_KEY=
#
# --- Malware analysis -----------------------------------------------------
# Known-good hash allowlist: one MD5/SHA1/SHA256 per line ('#' comments allowed),
# e.g. an NSRL RDS export or your golden-image inventory. A listed hash clears a
# verdict that rests only on heuristics — the main brake on false positives when
# system binaries end up in the queue. Hard detections (YARA / reputation /
# ClamAV / extracted config / ransomware) are never overridden by it.
# MALWARE_GOODWARE_LIST=/app/data/goodware-hashes.txt
#
# Offline AV: mount a ClamAV signature DB into the emulator sidecar to enable the
# ClamAV pass in triage. Signatures are NEVER downloaded during the image build.
#   mkdir -p clamav-db && freshclam --datadir=./clamav-db
# CLAMAV_DB_PATH=./clamav-db
#
# --- GreyNoise: NO KEY NEEDED ---------------------------------------------
# The "greynoise" collector uses the keyless community endpoint. A free Visualizer
# account does NOT issue an API key (that's paid-only). Leave this UNSET; set it
# only if you have a paid key and want a higher daily limit.
# GREYNOISE_API_KEY=
#
# --- OSINT-only extras ----------------------------------------------------
# NumVerify phone metadata — LOW priority: phone_meta already derives carrier /
# region / line-type OFFLINE via libphonenumber. Get (free): https://numverify.com
OSINT_NUMVERIFY_API_KEY=
# HaveIBeenPwned — PAID (~$3.95/mo): https://haveibeenpwned.com/API/Key
# Optional: breach data is already covered keyless by XposedOrNot + ProxyNova.
OSINT_HIBP_API_KEY=
#
# Active port scan ("portscan" collector) — FULL 1-65535 sweep on every target by
# default. Lower these only to throttle on slow/constrained links.
# OSINT_PORTSCAN_MAX=65535
# OSINT_PORTSCAN_CONCURRENCY=800
# OSINT_PORTSCAN_MAX_HOSTS=2   # hosts full-scanned at once engine-wide (socket guard)
#
# Cloud-storage exposure ("cloud" collector) — permutes the target domain into
# bucket names and probes public S3/GCS/Azure storage. Caps the candidate count.
# OSINT_CLOUD_MAX_CANDIDATES=120
#
# Max OSINT scans executing at once engine-wide. Every scan (root + auto-pivot
# child) queues through this limit so a wide/deep graph can't exhaust resources.
# Queued scans stay "pending" until a slot frees.
# OSINT_MAX_CONCURRENT_SCANS=6
#
# Shared-hosting guard: if an IP hosts more than this many co-hosted domains it
# is treated as shared infrastructure and its co-hosted domains are recorded as
# findings but NOT auto-pivoted (they are other tenants, not the subject).
# OSINT_COHOST_PIVOT_MAX=5
#
# Auto-pivot child budget per scan. After out-of-scope/noise entities are
# filtered out, the budget is split round-robin across categories (IP / domain /
# account / other) so a target's related IPs, domains AND accounts are each
# investigated rather than one class crowding out the rest.
# OSINT_MAX_PIVOT_CHILDREN=12
#
# OSINT endpoint overrides (defaults are fine for most deployments):
# API_NUMVERIFY_URL=http://apilayer.net/api/validate
# API_IP_API_URL=http://ip-api.com/json/
# API_WEB_ARCHIVE_URL=http://web.archive.org/cdx/search/cdx

# ─── Log Search (built-in Elasticsearch) ───────────────────
# The "Log Ingest" tab on the SIEM Threat Hunting page uploads collected logs
# (evtx/access/firewall/syslog/json/csv), parses them to ECS and bulk-indexes
# them into the bundled Elasticsearch. On first boot the backend auto-registers
# this cluster as an ELK hunting profile ("Local Log Store") so the ingested
# logs are searchable right there. Set LOGSEARCH_ES_URL empty to disable the
# whole module (the elasticsearch container can then be removed from compose).
LOGSEARCH_ES_URL=http://elasticsearch:9200
# Elasticsearch image tag and JVM heap. ES needs real RAM — budget ~2-3 GB for
# it on top of the rest of the stack (raise the host to ~10-12 GB total).
LOGSEARCH_ES_VERSION=8.17.3
LOGSEARCH_ES_MEM=2g
# Container memory caps (keep ES limit comfortably above LOGSEARCH_ES_MEM heap).
LOGSEARCH_ES_MEM_LIMIT=3g
KIBANA_MEM_LIMIT=1500m
# Retention: ingested hunt-* logs are auto-deleted after this many days by an ILM
# policy (protects RAM/disk on a long-running box). 0 = keep forever.
LOGSEARCH_RETENTION_DAYS=30
# LOGSEARCH_ES_PORT only matters if you uncomment the host port mapping in
# docker-compose.yml to reach Elasticsearch directly for debugging.
# LOGSEARCH_ES_PORT=9200
# Full Kibana (view logs, build detection rules/alerts, dashboards) is served
# same-origin under /kbn through the frontend and embedded as the in-app "Kibana"
# page — reachable at http://<host>:FRONTEND_PORT/kbn. Its version tracks
# LOGSEARCH_ES_VERSION. Set KIBANA_PUBLIC_URL to how the browser reaches it
# (scheme+host+/kbn); change localhost to the LAN IP/domain when not on the host.
KIBANA_PUBLIC_URL=http://localhost:3000/kbn
# Internal Kibana URL the backend uses to auto-create the hunt-* data view.
LOGSEARCH_KIBANA_URL=http://kibana:5601/kbn
# Kibana encryption keys (each >= 32 chars). REQUIRED for Alerting rules,
# Actions/Connectors and Reporting. Change these for production and keep them
# stable afterwards (rotating them orphans previously-encrypted objects).
KIBANA_ESO_ENCRYPTIONKEY=analysishub_kibana_encrypted_saved_objects_key_0
KIBANA_SECURITY_ENCRYPTIONKEY=analysishub_kibana_security_session_key_000000000
KIBANA_REPORTING_ENCRYPTIONKEY=analysishub_kibana_reporting_encryption_key_00000
# ELK power toggle: the Log Ingest tab can start/stop the ES+Kibana containers
# to free their ~3-4 GB RAM when idle. It works out of the box via the scoped
# docker_socket_proxy service (see docker-compose.yml) — the backend never gets
# the raw docker socket, only inspect/start/stop on containers. Leave as-is to
# keep the toggle enabled; set empty to hide it (falls back to a manual command).
DOCKER_API_URL=http://docker_socket_proxy:2375

# ─── Idle auto-shutdown (ELK + Sandbox) ─────────────────────
# The ELK (Elasticsearch+Kibana) and volatility Sandbox containers are RAM-heavy
# but only used intermittently. When enabled, a background reaper stops each one
# after it goes unused for the timeout below, and it auto-starts again the moment
# an analyst opens its page (or via the admin toggle). Requires DOCKER_API_URL.
# Set IDLE_POWER_ENABLED=false to keep them always-on.
IDLE_POWER_ENABLED=true
ELK_IDLE_TIMEOUT_MIN=3
SANDBOX_IDLE_TIMEOUT_MIN=3

# ─── Threat Hunting (Sigma) ─────────────────────────────────
# Source archive (zip) for `POST /api/v1/hunting/sigma/sync`, which pulls a
# community ruleset into tools/sigma-rules and reloads the engine. Defaults to
# the SigmaHQ master branch archive when unset.
# SIGMA_RULES_URL=https://github.com/SigmaHQ/sigma/archive/refs/heads/master.zip

# ─── Reporting ─────────────────────────────────────────────
# Optional external HTML→PDF renderer for native PDF export of reports
# (e.g. a Gotenberg instance: http://gotenberg:3000/forms/chromium/convert/html).
# When unset, reports are served as HTML and the browser's print-to-PDF is used.
# PDF_RENDERER_URL=

# ─── Security ──────────────────────────────────────────────
# AES_ENCRYPTION_KEY must be exactly 32 bytes (256-bit) for OpenCTI credential encryption.
AES_ENCRYPTION_KEY=your-secure-32-byte-key-goes-here-

# ─── OOB interaction server ("Catch" — Interactsh / Burp Collaborator) ────
# A controlled DNS + HTTP(S) + SMTP endpoint that records out-of-band callbacks
# from a target, to confirm BLIND vulns (SSRF, blind XXE/RCE/SQLi, email-header
# injection) on AUTHORISED engagements only.
#
# Setup (one-time):
#   1. Pick a domain you control, e.g. oob.example.com.
#   2. At your DNS registrar, delegate it to THIS host:
#        oob.example.com.   NS    ns1.oob.example.com.
#        ns1.oob.example.com. A   <OOB_PUBLIC_IP>     (glue record)
#   3. Point OOB_PUBLIC_IP at this host's public IPv4.
#   4. Open host ports 53/udp+tcp, 80, 25 (and 443 if using TLS) — uncomment the
#      OOB port block in docker-compose.yml.
#   5. Set OOB_ENABLED=true and restart.
# Generated payload: <correlation><unique>.oob.example.com — any DNS/HTTP/SMTP
# hit on it is captured and attributed in the OSINT → Catch page.
OOB_ENABLED=false
OOB_DOMAIN=
OOB_PUBLIC_IP=
OOB_PUBLIC_IPV6=
OOB_NS_NAME=
# Optional HTTPS catch-all — provide a wildcard cert for *.OOB_DOMAIN (paths
# inside the container, e.g. mounted under /app/data).
OOB_TLS_CERT=
OOB_TLS_KEY=
# Anti-abuse / retention for the public webhook receiver.
OOB_RATE_LIMIT_PER_MIN=600   # max recorded hits per token per minute
OOB_MAX_PER_CLIENT=10000     # max stored interactions per session (0 = unlimited)
OOB_RETENTION_DAYS=30        # delete interactions older than this (0 = keep forever)
# JNDI (Log4Shell) callback catchers — confirm the second-stage LDAP/RMI connect
# from ${jndi:ldap://<OOB_DOMAIN>:1389/<payload>}. Only start with OOB_ENABLED.
# Open these host ports in docker-compose when enabling. Empty/0 disables.
OOB_LDAP_PORT=1389
OOB_RMI_PORT=1099

# ─── Outbound egress proxy ────────────────────────────────────────
# Project-wide proxy for EXTERNAL fetches (OSINT, threat-intel, CVE, news, AI,
# notify, OOB enrichment). http(s) or socks5. Empty = direct. Can also be changed
# at runtime from System Health → Egress Proxy (no restart). Internal SIEM
# connectors bypass it by design.
OUTBOUND_PROXY=
OUTBOUND_NO_PROXY=                                  # extra hosts/CIDRs to bypass (loopback always bypassed)
OUTBOUND_PROXY_FALLBACK_DIRECT=false                # auto-fall-back to direct when the proxy is unhealthy
OUTBOUND_PROXY_PROBE_URL=https://www.google.com/generate_204   # health-check target

# Dedicated proxy for OSINT recon ONLY (hides the operator IP from targets without
# routing news/AI/CVE). Use a CLEAN residential/datacenter proxy — NOT Tor, whose
# exit nodes are widely 403-blocked by Cloudflare/WAFs. http(s) or socks5.
# Precedence for OSINT: OSINT_PROXY → OUTBOUND_PROXY / Proxy Manager → direct.
# Empty = fall back to OUTBOUND_PROXY (or direct). OSINT is never forced onto Tor.
OSINT_PROXY=

# ─── Reverse-proxy trust ──────────────────────────────────────────
# When set (comma-separated IPs/CIDRs of your front proxy, e.g. nginx/Cloudflare),
# X-Forwarded-For / X-Forwarded-Proto are only honoured from those hops — stops
# source-IP / scheme spoofing on captured OOB callbacks. Empty = trust all (gin default).
TRUSTED_PROXIES=

# ─── Sandbox terminal (volatility/kali) ──────────────────────────
# Internal address of the ttyd web terminal the backend reverse-proxies behind
# an admin JWT. The sandbox container is NOT published on the host; leave this
# as the compose service name unless you relocate the container.
SANDBOX_TERMINAL_URL=http://volatility_sandbox:7681

# ─── Malware sandbox network ─────────────────────────────────────
# The detonation network is isolated (internal: true) and carries its own
# subnet. Change it ONLY if 10.99.0.0/24 collides with something the host
# already routes — a VPN, a corporate LAN, or another Docker stack. The symptom
# of a collision is `docker compose up` failing with:
#   invalid pool request: Pool overlaps with other one on this address space
#
# SINKHOLE_IP must stay INSIDE SANDBOX_SUBNET: it is pinned so it can serve as
# the sandbox's DNS resolver without needing a lookup of its own. Change both
# together or neither.
SANDBOX_SUBNET=10.99.0.0/24
SINKHOLE_IP=10.99.0.5

# ─── Frontend build (LEAVE EMPTY for portable bundle) ─────────────
# Empty → axios uses relative URLs, WS code derives wss://${window.location.host}.
# Same JS bundle works for LAN (http://x.x.x.x:3000) and for the
# domain (https://example.domain) — no rebuild on cutover.
# The frontend nginx already proxies /api/, /ws/, /catch/ to the backend.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
