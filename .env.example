# ─── App ───────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=3000

# ─── Database ──────────────────────────────────────────────
POSTGRES_DB=forensichub
POSTGRES_USER=forensic
POSTGRES_PASSWORD=forensic_secret

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars

# ─── Admin seed account ────────────────────────────────────
ADMIN_EMAIL=admin@forensichub.local
ADMIN_PASSWORD=Admin@123456

# Base URL used for agent install scripts and job dispatch.
# Automatically detected from request headers if unset.
# Examples: "http://192.168.1.10:8080" or "https://hub.example.com"
PUBLIC_URL=

# Force the automatically-detected URL to use HTTPS.
# Set to 'true' if running behind an SSL-terminating proxy that does
# not send standard X-Forwarded-Proto headers.
USE_HTTPS=false

# Browser origins allowed for CORS and WebSocket upgrades (comma-separated).
# MUST include every URL from which the frontend is served. Empty defaults to
# "http://localhost:3000,http://127.0.0.1:3000" for local development.
# Example (prod): https://hub.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://x.x.x.x:3000,http://localhost:3000,http://127.0.0.1:3000,https://example.domain

# ─── CVE Intel (optional, raises rate limits) ─────────────
# NVD: 5 req/30s without key → 50 with key. Free signup: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub Search: 10 req/min without token → 30 with token. Personal access token (no scopes needed).
GITHUB_TOKEN=

# ─── Security ──────────────────────────────────────────────
# AES_ENCRYPTION_KEY must be exactly 32 bytes (256-bit) for OpenCTI credential encryption.
AES_ENCRYPTION_KEY=your-secure-32-byte-key-goes-here-

# ─── Frontend build (LEAVE EMPTY for portable bundle) ─────────────
# Empty → axios uses relative URLs, WS code derives wss://${window.location.host}.
# Same JS bundle works for LAN (http://x.x.x.x:3000) and for the
# domain (https://example.domain) — no rebuild on cutover.
# The frontend nginx already proxies /api/, /ws/, /catch/ to the backend.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
