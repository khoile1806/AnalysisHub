# ─── App ───────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=3000

# ─── Database ──────────────────────────────────────────────
POSTGRES_DB=forensichub
POSTGRES_USER=forensic
POSTGRES_PASSWORD=forensic_secret

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars

# ─── Admin seed account ────────────────────────────────────
ADMIN_EMAIL=admin@forensichub.local
ADMIN_PASSWORD=Admin@123456

# Base URL used for agent install scripts and job dispatch.
# Automatically detected from request headers if unset.
# Examples: "http://192.168.1.10:8080" or "https://hub.example.com"
PUBLIC_URL=

# Force the automatically-detected URL to use HTTPS.
# Set to 'true' if running behind an SSL-terminating proxy that does
# not send standard X-Forwarded-Proto headers.
USE_HTTPS=false

# Browser origins allowed for CORS and WebSocket upgrades (comma-separated).
# MUST include every URL from which the frontend is served. Empty defaults to
# "http://localhost:3000,http://127.0.0.1:3000" for local development.
# Example (prod): https://hub.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://x.x.x.x:3000,http://localhost:3000,http://127.0.0.1:3000,https://example.domain

# ─── CVE Intel (optional, raises rate limits) ─────────────
# NVD: 5 req/30s without key → 50 with key. Free signup: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub Search: 10 req/min without token → 30 with token. Personal access token (no scopes needed).
GITHUB_TOKEN=

# ─── Security ──────────────────────────────────────────────
# AES_ENCRYPTION_KEY must be exactly 32 bytes (256-bit) for OpenCTI credential encryption.
AES_ENCRYPTION_KEY=your-secure-32-byte-key-goes-here-

# ─── OSINT Footprinting (all optional) ─────────────────────
# The OSINT module works out of the box using free no-key sources (RDAP/WHOIS,
# DNS, crt.sh, Shodan InternetDB, Wayback Machine, ip-api, Gravatar). Each key
# below simply unlocks one richer collector — leave blank to skip that source.
# VirusTotal & Shodan: leave blank to reuse the SUBFINDER_VIRUSTOTAL /
# SUBFINDER_SHODAN keys already configured for the recon module.
#   VirusTotal : https://www.virustotal.com/gui/my-apikey   (domain reputation)
#   Shodan     : https://account.shodan.io/                 (full host data)
#   AbuseIPDB  : https://www.abuseipdb.com/account/api       (IP abuse score)
#   HIBP       : https://haveibeenpwned.com/API/Key          (email breach check)
#   NumVerify  : https://numverify.com/                      (phone carrier/line type)
OSINT_VIRUSTOTAL_API_KEY=
OSINT_SHODAN_API_KEY=
OSINT_ABUSEIPDB_API_KEY=
OSINT_HIBP_API_KEY=
OSINT_NUMVERIFY_API_KEY=

# ─── Frontend build ────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ─── Recon: subfinder provider API keys ──────────────────────────
# Rendered into ~/.config/subfinder/provider-config.yaml at backend container
# start. Leave empty to skip a source. Multiple keys per source: comma-separated.
# Censys uses "API_ID:API_SECRET" concatenated.
#
# Free tiers (signup → free key):
#   VirusTotal  : https://www.virustotal.com/gui/my-apikey
#   AlienVault  : https://otx.alienvault.com/api
#   Urlscan     : https://urlscan.io/user/profile
#   Censys      : https://search.censys.io/account/api
#   FullHunt    : https://fullhunt.io/user/settings
#   GitHub      : https://github.com/settings/tokens  (no scopes needed)
#
# Paid / trial:
#   Shodan        : https://account.shodan.io/
#   SecurityTrails: https://securitytrails.com/app/account/credentials
#   BinaryEdge    : https://app.binaryedge.io/account/api
#   Chaos (PD)    : https://chaos.projectdiscovery.io/  (invite-based)
SUBFINDER_VIRUSTOTAL=
SUBFINDER_ALIENVAULT=
SUBFINDER_URLSCAN=
SUBFINDER_SHODAN=
SUBFINDER_CENSYS=
SUBFINDER_FULLHUNT=
SUBFINDER_GITHUB=
SUBFINDER_SECURITYTRAILS=
SUBFINDER_BINARYEDGE=
SUBFINDER_CHAOS=

# ─── Password Reset Account Detection ────────────────────────
# Enable password reset detector for email/phone investigations
ENABLE_PASSWORD_RESET_DETECTOR=true

# Timeout per password reset check (seconds)
PASSWORD_RESET_TIMEOUT=15

# Delay between requests to same platform (milliseconds) - respect rate limits
PASSWORD_RESET_RATE_LIMIT_DELAY=2000

# Minimum confidence threshold to report finding (0.0 - 1.0)
# Only report if confidence >= this threshold
PASSWORD_RESET_CONFIDENCE_THRESHOLD=0.65

# Enable audit logging for all password reset checks
PASSWORD_RESET_AUDIT_LOG=true

