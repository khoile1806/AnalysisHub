# ═══════════════════════════════════════════════════════════════════════════════
#  AnalysisHub v2 — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
*.env.local
.env.*
!.env.example

# ── Local backups (scripts/backup.sh output) ────────────────────────────────
backups/

# ── Recon tool API key configs (copy from *.example and fill in keys) ──────
recon-config/amass/config.yaml
recon-config/subfinder/provider-config.yaml

# ── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ═══════════════════════════════════════════════════════════════════════════════
#  COMPILED BINARIES & BUILD ARTIFACTS
#  (Tất cả binary được Docker/Makefile tự tạo — KHÔNG commit lên Git)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Go compiled binaries ────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Agent compiled outputs ──────────────────────────────────────────────────
agent/bin/
agent/analysishub-agent
agent/analysishub-agent-linux
agent/analysishub-agent-darwin-amd64
agent/analysishub-agent-darwin-arm64

# ── Backend compiled outputs ────────────────────────────────────────────────
backend/bin/
backend/server
backend/data

# ── Frontend build & dependencies ───────────────────────────────────────────
frontend/dist/
frontend/node_modules/

# ── Agent build outputs ─────────────────────────────────────────────────────
agent/dist/

# ── Yara-scanner build outputs ──────────────────────────────────────────────
tools/yara-scanner/build/
tools/yara-scanner/dist/
tools/yara-scanner/webshell_scanner.egg-info/
tools/yara-scanner/out/
tools/yara-scanner/report/
tools/yara-scanner/report_test/

# ── Python virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/
tools/yara-scanner/.venv/

# ═══════════════════════════════════════════════════════════════════════════════
#  RUNTIME DATA & LOGS
#  (Dữ liệu runtime sinh ra khi hệ thống chạy — KHÔNG thuộc source code)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Backend runtime logs (NOT seed data — seed JSON must be committed) ──────
backend/data/logs/
!backend/data/logs/.gitkeep

# ── Application logs ────────────────────────────────────────────────────────
*.log
logs/
# …but keep the log-parser test fixtures (they end in .log/.csv/.ndjson and MUST
# be committed or the logsearch unit tests fail on a fresh clone / in CI).
!backend/internal/logsearch/testdata/
!backend/internal/logsearch/testdata/**

# ── Docker volumes / persistent storage ─────────────────────────────────────
storage_data/
postgres_data/
redis_data/

# ── Memory dump files (quá lớn để commit) ───────────────────────────────────
*.raw
*.dmp
*.dump
*.vmem
*.lime

# ═══════════════════════════════════════════════════════════════════════════════
#  TEST & SCRATCH FILES
#  (File test tạm, scratch script — KHÔNG cần đẩy lên Git)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Root-level test/scratch files ───────────────────────────────────────────
test_exec.go
test_*.go
test.ps1
test.bat

# ── Python bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Go test binary outputs ──────────────────────────────────────────────────
*.test
*.test.exe

# ── Coverage output ─────────────────────────────────────────────────────────
coverage.out
coverage.html
*.coverprofile

# ═══════════════════════════════════════════════════════════════════════════════
#  OS-SPECIFIC JUNK
# ═══════════════════════════════════════════════════════════════════════════════
.DS_Store
.AppleDouble
.LSOverride
._*
*.swp
*~
# ── Local docs (not pushed) ─────────────────────────────────────────────────
docs/
