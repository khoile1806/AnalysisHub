# Subfinder provider config — rendered at container start from env vars by
# render-provider-config.sh. Sources without an env var stay empty and are
# silently skipped by subfinder.
#
# To enable a source, set the matching env var in docker-compose (or .env):
#   SUBFINDER_SHODAN, SUBFINDER_VIRUSTOTAL, SUBFINDER_CENSYS, ...
# Multiple keys for the same source: comma-separated.
# Censys takes an "id:secret" pair; concatenate with ':' in the env var.
bevigil: [${SUBFINDER_BEVIGIL}]
binaryedge: [${SUBFINDER_BINARYEDGE}]
bufferover: [${SUBFINDER_BUFFEROVER}]
builtwith: [${SUBFINDER_BUILTWITH}]
