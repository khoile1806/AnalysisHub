# Subfinder provider-config — API keys for passive subdomain enumeration.
#
# IMPORTANT: This repo renders the real provider-config.yaml from env vars at
# container start. To configure keys, edit `.env` (gitignored) — do NOT paste
# real keys into this file or commit them.
#
# Example .env block:
#   SUBFINDER_VIRUSTOTAL=your_virustotal_api_key
#   SUBFINDER_ALIENVAULT=your_alienvault_api_key
#   SUBFINDER_URLSCAN=your_urlscan_api_key
#   SUBFINDER_SHODAN=your_shodan_api_key
#   SUBFINDER_GITHUB=ghp_your_github_personal_access_token
#   SUBFINDER_CENSYS=YOUR_CENSYS_API_ID:YOUR_CENSYS_API_SECRET
#
# Without API keys, subfinder still queries 40+ free sources (cert transparency,
# passive DNS, etc). With keys it queries 95+ sources for much better coverage.
#
# GET FREE API KEYS:
#   VirusTotal    : https://www.virustotal.com/gui/my-apikey
#   AlienVault    : https://otx.alienvault.com/api
#   Censys        : https://search.censys.io/account/api
#   FullHunt      : https://fullhunt.io/user/settings
#   Urlscan       : https://urlscan.io/user/profile
#   Chaos (PD)    : https://chaos.projectdiscovery.io/  (invite-based)
#   GitHub (token): https://github.com/settings/tokens  (no scopes needed)
#
# PAID (trial/limited free):
#   SecurityTrails: https://securitytrails.com/app/account/credentials
#   Shodan        : https://account.shodan.io/
#   BinaryEdge    : https://app.binaryedge.io/account/api
#
# Below is the literal subfinder yaml format. Useful only if you decide to
# bypass the envsubst flow and mount this file directly into the container.

virustotal:
  - YOUR_VIRUSTOTAL_API_KEY

alienvault:
  - YOUR_ALIENVAULT_API_KEY

censys:
  - YOUR_CENSYS_API_ID:YOUR_CENSYS_API_SECRET

fullhunt:
  - YOUR_FULLHUNT_API_KEY

urlscan:
  - YOUR_URLSCAN_API_KEY

# chaos:
#   - YOUR_CHAOS_API_KEY

github:
  - YOUR_GITHUB_PERSONAL_ACCESS_TOKEN

securitytrails:
  - YOUR_SECURITYTRAILS_API_KEY

shodan:
  - YOUR_SHODAN_API_KEY

binaryedge:
  - YOUR_BINARYEDGE_API_KEY

# hunterhow:
#   - email=YOUR_EMAIL,key=YOUR_KEY

# fofa:
#   - email=YOUR_EMAIL,key=YOUR_KEY
