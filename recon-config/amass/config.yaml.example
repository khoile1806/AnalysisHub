# Amass v3 configuration — API keys for passive subdomain enumeration.
#
# IMPORTANT: This repo does NOT render amass config from env vars (only
# subfinder is templated). To enable keys for amass:
#   1. Copy this file:  cp config.yaml.example config.yaml
#   2. Fill in real keys (config.yaml is gitignored)
#   3. Restart backend:  docker compose restart backend
#
# Do NOT commit real keys into this .example file — it is checked into git.
#
# GET FREE API KEYS:
#   VirusTotal   : https://www.virustotal.com/gui/my-apikey
#   AlienVault   : https://otx.alienvault.com/api
#   Censys       : https://search.censys.io/account/api
#   FullHunt     : https://fullhunt.io/user/settings
#   Urlscan      : https://urlscan.io/user/profile
#
# PAID (trial available):
#   SecurityTrails: https://securitytrails.com/app/account/credentials
#   Shodan        : https://account.shodan.io/
#   BinaryEdge    : https://app.binaryedge.io/account/api

options:
  timeout: 20        # max runtime in minutes for passive enumeration
  resolvers:
    - 8.8.8.8
    - 8.8.4.4
    - 1.1.1.1
    - 1.0.0.1

datasources:
  - name: AlienVault
    ttl: 4320
    creds:
      - key: YOUR_ALIENVAULT_API_KEY

  - name: VirusTotal
    ttl: 10080
    creds:
      - key: YOUR_VIRUSTOTAL_API_KEY

  - name: Censys
    ttl: 10080
    creds:
      - username: YOUR_CENSYS_API_ID
        password: YOUR_CENSYS_API_SECRET

  - name: FullHunt
    ttl: 10080
    creds:
      - key: YOUR_FULLHUNT_API_KEY

  - name: SecurityTrails
    ttl: 10080
    creds:
      - key: YOUR_SECURITYTRAILS_API_KEY

  - name: Shodan
    ttl: 10080
    creds:
      - key: YOUR_SHODAN_API_KEY

  - name: BinaryEdge
    ttl: 10080
    creds:
      - key: YOUR_BINARYEDGE_API_KEY

  - name: URLScan
    ttl: 10080
    creds:
      - key: YOUR_URLSCAN_API_KEY

  - name: Hunter
    ttl: 4320
    creds:
      - key: YOUR_HUNTER_API_KEY
