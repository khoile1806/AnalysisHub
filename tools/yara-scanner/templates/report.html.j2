<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Webshell Scan Report — {{ report.scanned_at.strftime("%Y-%m-%d %H:%M") }}</title>
<script src="https://cdn.tailwindcss.com"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13/dist/cdn.min.js"></script>
<style>
  body { font-family: ui-sans-serif, system-ui, sans-serif; }
  pre { white-space: pre-wrap; word-break: break-word; }
  .badge-critical { background:#7f1d1d; color:#fca5a5; border:1px solid #991b1b; }
  .badge-high     { background:#431407; color:#fdba74; border:1px solid #9a3412; }
  .badge-medium   { background:#422006; color:#fde68a; border:1px solid #92400e; }
  .badge-low      { background:#1e293b; color:#94a3b8; border:1px solid #334155; }
  .border-critical { border-left: 3px solid #ef4444; }
  .border-high     { border-left: 3px solid #f97316; }
  .border-medium   { border-left: 3px solid #eab308; }
  .border-low      { border-left: 3px solid #64748b; }
  .score-ring { display:inline-flex; align-items:center; justify-content:center;
    width:3rem; height:3rem; border-radius:50%; font-weight:700; font-size:.85rem;
    flex-shrink:0; }
  .score-critical { background:#7f1d1d; color:#fca5a5; border:2px solid #ef4444; }
  .score-high     { background:#431407; color:#fdba74; border:2px solid #f97316; }
  .score-medium   { background:#422006; color:#fde68a; border:2px solid #eab308; }
  .score-low      { background:#1e293b; color:#94a3b8; border:2px solid #64748b; }
  code.snippet {
    display:block; background:#0d1117; border:1px solid #30363d;
    border-radius:.375rem; padding:1rem; font-family:ui-monospace,monospace;
    font-size:.78rem; color:#e6edf3; overflow-x:auto; line-height:1.6;
  }
  .reason-tag {
    display:inline-block; font-size:.7rem; font-family:ui-monospace,monospace;
    background:#1e293b; color:#7dd3fc; border:1px solid #0369a1;
    padding:1px 8px; border-radius:9999px;
  }
  .engine-tag {
    display:inline-block; font-size:.7rem;
    background:#14532d; color:#86efac; border:1px solid #166534;
    padding:1px 8px; border-radius:9999px;
  }
</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen"
  x-data="{ q: '', sev: 'all', showing: 0 }">

<!-- ═══ HEADER ═══════════════════════════════════════════════════════════ -->
<header class="border-b border-slate-800 bg-slate-900 px-6 py-5">
  <div class="max-w-6xl mx-auto flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white">Webshell Scan Report</h1>
      <p class="text-sm text-slate-400 mt-1">
        <span class="text-slate-300 font-medium">{{ report.hostname }}</span>
        &nbsp;·&nbsp;Scanner <code class="text-slate-300">v{{ report.scanner_version }}</code>
        &nbsp;·&nbsp;Rules <code class="text-slate-300">{{ report.rules_version }}</code>
        &nbsp;·&nbsp;{{ report.scanned_at.isoformat(timespec="seconds") }}
      </p>
      <p class="text-xs text-slate-500 mt-1">
        Targets: {% for t in report.targets %}<code class="text-slate-400">{{ t }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
    </div>
    {% set matched = report.stats.matched %}
    {% if matched == 0 %}
    <div class="flex items-center gap-2 bg-green-950 border border-green-800 rounded-lg px-4 py-2">
      <span class="text-green-400 text-xl">✓</span>
      <span class="text-green-300 font-semibold">No findings</span>
    </div>
    {% else %}
    <div class="flex items-center gap-2 bg-red-950 border border-red-800 rounded-lg px-4 py-2">
      <span class="text-red-400 text-xl">⚠</span>
      <span class="text-red-300 font-semibold">{{ matched }} finding{{ 's' if matched != 1 }}</span>
    </div>
    {% endif %}
  </div>
</header>

<!-- ═══ STATS BAR ════════════════════════════════════════════════════════ -->
<section class="border-b border-slate-800 bg-slate-900/50">
  <div class="max-w-6xl mx-auto grid grid-cols-4 sm:grid-cols-8 gap-0 divide-x divide-slate-800">
    {% set stat_items = [
      ("Total", report.stats.total_files, "text-slate-300"),
      ("Scanned", report.stats.scanned, "text-slate-300"),
      ("Errors", report.stats.errors, "text-red-400" if report.stats.errors else "text-slate-500"),
      ("Matched", report.stats.matched, "text-orange-300" if report.stats.matched else "text-slate-500"),
      ("Critical", severity_counts.get("critical", 0), "text-red-400"),
      ("High", severity_counts.get("high", 0), "text-orange-400"),
      ("Medium", severity_counts.get("medium", 0), "text-yellow-400"),
      ("Low", severity_counts.get("low", 0), "text-slate-400"),
    ] %}
    {% for label, val, cls in stat_items %}
    <div class="px-4 py-3 text-center">
      <div class="text-xs text-slate-500 uppercase tracking-wide">{{ label }}</div>
      <div class="text-xl font-bold {{ cls }}">{{ val }}</div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ═══ FILTERS ══════════════════════════════════════════════════════════ -->
<section class="max-w-6xl mx-auto px-4 pt-5 pb-3">
  <div class="flex flex-wrap gap-3 items-center">
    <input type="text" x-model="q" placeholder="🔍  Search by path…"
      class="bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-sm w-80 focus:outline-none focus:border-blue-500" />
    <div class="flex gap-1">
      {% for sev in ["all", "critical", "high", "medium", "low"] %}
      <button @click="sev = '{{ sev }}'"
        :class="sev === '{{ sev }}' ? 'bg-slate-600 text-white' : 'bg-slate-900 text-slate-400 hover:bg-slate-800'"
        class="px-3 py-1.5 rounded text-xs border border-slate-700 transition-colors">
        {{ sev|capitalize }}
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══ FINDINGS LIST ════════════════════════════════════════════════════ -->
<main class="max-w-6xl mx-auto px-4 pb-12 space-y-4">
  {% for f in sorted_findings %}
  <article class="rounded-xl bg-slate-900 border border-slate-800 border-{{ f.severity }} overflow-hidden"
    x-show="(sev === 'all' || sev === '{{ f.severity }}') && '{{ f.path|e }}'.toLowerCase().includes(q.toLowerCase())"
    x-data="{ open: true }">

    <!-- Finding header -->
    <div class="flex items-start gap-4 p-4">
      <!-- Score ring -->
      <div class="score-ring score-{{ f.severity }} mt-0.5">{{ f.score }}</div>

      <!-- Main info -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="text-xs font-bold px-2 py-0.5 rounded badge-{{ f.severity }}">{{ f.severity|upper }}</span>
          {% for eng in f.engines %}
          <span class="engine-tag">{{ eng }}</span>
          {% endfor %}
          <span class="text-xs text-slate-500">{{ f.size_bytes | int }} bytes</span>
        </div>

        <!-- File path -->
        <div class="font-mono text-sm text-white break-all leading-relaxed mb-2">{{ f.path }}</div>

        <!-- SHA256 -->
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs text-slate-500">SHA256:</span>
          <code class="text-xs text-slate-400 font-mono break-all">{{ f.sha256 }}</code>
        </div>

        <!-- Rules fired -->
        <div class="flex flex-wrap gap-1.5">
          {% for r in f.reasons %}
          <span class="reason-tag">{{ r }}</span>
          {% endfor %}
        </div>
      </div>

      <!-- Snippet toggle -->
      {% if f.snippet %}
      <button @click="open = !open"
        class="flex-shrink-0 text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-lg transition-colors mt-1">
        <span x-text="open ? '▲ Hide code' : '▼ Show code'"></span>
      </button>
      {% endif %}
    </div>

    <!-- Code snippet -->
    {% if f.snippet %}
    <div x-show="open" x-cloak>
      <div class="px-4 pb-1 text-xs text-slate-500 font-semibold uppercase tracking-wide">Detected shell code</div>
      <div class="px-4 pb-4"
        x-data="{ b64: '{{ f.snippet|b64encode }}', decoded: '' }"
        x-init="decoded = atob(b64)">
        <code class="snippet" x-text="decoded"></code>
      </div>
    </div>
    {% endif %}
  </article>

  {% else %}
  <div class="text-center py-20 text-slate-500">
    <div class="text-5xl mb-4">✓</div>
    <div class="text-xl font-semibold text-slate-400">No findings match the current filter</div>
  </div>
  {% endfor %}
</main>

<!-- ═══ FOOTER ═══════════════════════════════════════════════════════════ -->
<footer class="border-t border-slate-800 px-6 py-4 text-xs text-slate-600 text-center">
  Generated by <strong class="text-slate-500">yara-scanner v{{ report.scanner_version }}</strong>
  &nbsp;·&nbsp; Rules {{ report.rules_version }}
  &nbsp;·&nbsp; {{ report.scanned_at.isoformat(timespec="seconds") }}
</footer>

</body>
</html>
